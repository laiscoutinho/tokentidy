{
  "name": "tokentidy",
  "version": "0.0.2",
  "description": "Finds hardcoded visual values in front-end code and helps migrate them to design tokens.",
  "keywords": [
    "design-tokens",
    "design-system",
    "tokens",
    "dtcg",
    "lint",
    "linter",
    "cli",
    "css",
    "scss",
    "react",
    "jsx",
    "angular",
    "hardcoded-values",
    "autofix",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laiscoutinho/tokentidy.git"
  },
  "author": {
    "name": "Laís Coutinho",
    "url": "https://github.com/laiscoutinho"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22.17.0"
  },
  "bugs": {
    "url": "https://github.com/laiscoutinho/tokentidy/issues"
  },
  "homepage": "https://github.com/laiscoutinho/tokentidy#readme",
  "type": "module",
  "bin": {
    "tokentidy": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@csstools/css-color-parser": "^4.2.6",
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "postcss": "^8.5.30",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
